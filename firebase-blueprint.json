
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile within the Call on Demand ecosystem.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["Customer", "Agent", "Operator", "Admin"] },
        "assignedUnit": { "type": "string" },
        "status": { "type": "string" },
        "identityVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "referralCode": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "email", "phoneNumber", "role"]
    },
    "DeliveryTask": {
      "title": "DeliveryTask",
      "description": "A physical fulfillment task representing a logistics journey.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "serviceType": { "type": "string" },
        "locationUnit": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "customerUserId": { "type": "string" },
        "operatorId": { "type": "string" },
        "createdAt": { "type": "string" },
        "orderSummary": { "type": "string" },
        "packageImageUrl": { "type": "string" },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "statusHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "timestamp": { "type": "string" },
              "note": { "type": "string" },
              "operator": { "type": "string" }
            }
          }
        }
      }
    },
    "ShortletBooking": {
      "title": "ShortletBooking",
      "description": "A confirmed luxury stay booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "shortletId": { "type": "string" },
        "shortletName": { "type": "string" },
        "checkInDate": { "type": "string", "format": "date" },
        "checkOutDate": { "type": "string", "format": "date" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "bookingDate": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "unit": { "type": "string" }
      }
    },
    "Reward": {
      "title": "Reward",
      "description": "Loyalty points or cashback earned by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["Points", "Cashback"] },
        "amount": { "type": "number" },
        "points": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      }
    },
    "Contribution": {
      "title": "Contribution",
      "description": "A user's financial contribution to a crowdfunding campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "campaignId": { "type": "string" },
        "amount": { "type": "number" },
        "contributionDate": { "type": "string", "format": "date-time" },
        "paymentStatus": { "type": "string" }
      }
    },
    "FoodOrder": {
      "title": "FoodOrder",
      "description": "A confirmed order from a unit kitchen.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "orderDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "unit": { "type": "string" }
      }
    },
    "InvestmentAccount": {
      "title": "InvestmentAccount",
      "description": "A user's active stake in a growth plan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "investmentPlanId": { "type": "string" },
        "investedAmount": { "type": "number" },
        "currentValue": { "type": "number" },
        "maturityDate": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "ServiceNode": {
      "title": "ServiceNode",
      "description": "Generic structure for lifestyle catalog items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "locationUnit": { "type": "string" },
        "category": { "type": "string" },
        "isAvailable": { "type": "boolean" }
      }
    },
    "OperationalUnit": {
      "title": "OperationalUnit",
      "description": "A jurisdictional node where services are fulfilled.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "status"]
    },
    "InvestmentPlan": {
      "title": "InvestmentPlan",
      "description": "Financial growth options for platform users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "interestRate": { "type": "number" },
        "minAmount": { "type": "number" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["id", "name", "interestRate", "minAmount"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "A pre-registered access node for a new partner.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["Customer", "Agent", "Operator", "Admin"] },
        "assignedUnit": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Expired"] },
        "provisionedAt": { "type": "string", "format": "date-time" },
        "provisionedBy": { "type": "string" },
        "handshakeVerified": { "type": "boolean" }
      },
      "required": ["email", "firstName", "lastName", "role", "assignedUnit", "status"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" }
    },
    "/users/{userId}/rewards/{rewardId}": {
      "schema": { "$ref": "#/backend/entities/Reward" }
    },
    "/users/{userId}/contributions/{id}": {
      "schema": { "$ref": "#/backend/entities/Contribution" }
    },
    "/users/{userId}/foodOrders/{id}": {
      "schema": { "$ref": "#/backend/entities/FoodOrder" }
    },
    "/users/{userId}/investmentAccounts/{id}": {
      "schema": { "$ref": "#/backend/entities/InvestmentAccount" }
    },
    "/users/{userId}/shortletBookings/{id}": {
      "schema": { "$ref": "#/backend/entities/ShortletBooking" }
    },
    "/operational_units/{unitId}": {
      "schema": { "$ref": "#/backend/entities/OperationalUnit" }
    },
    "/menuItems/{id}": {
      "schema": { "$ref": "#/backend/entities/ServiceNode" }
    },
    "/productListings/{id}": { "schema": { "$ref": "#/backend/entities/ServiceNode" } },
    "/laundryServiceOptions/{id}": { "schema": { "$ref": "#/backend/entities/ServiceNode" } },
    "/shortletListings/{id}": { "schema": { "$ref": "#/backend/entities/ServiceNode" } },
    "/logisticsServiceOptions/{id}": { "schema": { "$ref": "#/backend/entities/ServiceNode" } },
    "/campaigns/{id}": { "schema": { "$ref": "#/backend/entities/ServiceNode" } },
    "/investmentPlans/{id}": { "schema": { "$ref": "#/backend/entities/InvestmentPlan" } },
    "/deliveryTasks/{taskId}": { "schema": { "$ref": "#/backend/entities/DeliveryTask" } },
    "/invitations/{email}": { "schema": { "$ref": "#/backend/entities/Invitation" } }
  }
}
